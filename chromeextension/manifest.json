{
    "name": "Keypass Guard",
    "version": "1.0.1",
    "description": "Securely store and fill your passwords on demand.",
    "manifest_version": 3,
    "permissions": [
        "storage",
        "tabs",
        "activeTab",
        "scripting",
        "cookies"
    ],
    "host_permissions": [
        "https://www.keypassguard.com/*",
        "https://*.keypassguard.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_icon": {
            "16": "assets/ext-icon.png",
            "24": "assets/ext-icon.png",
            "32": "assets/ext-icon.png"
        },
        "default_title": "Keypass Guard",
        "default_popup": "index.html"
    },
    "icons": {
        "16": "assets/ext-icon.png",
        "24": "assets/ext-icon.png",
        "32": "assets/ext-icon.png"
    }
}