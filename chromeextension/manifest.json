{
    "name": "Keypass Guard",
    "version": "0.1.0",
    "description": "Securely store and auto-fill your passwords.",
    "manifest_version": 3,
    "permissions": [
        "storage",
        "tabs",
        "activeTab",
        "scripting",
        "cookies"
    ],
    "host_permissions": [
        "<all_urls>",
        "http://localhost:3000/*",
        "http://localhost:3001/*",
        "https://www.keypassguard.com/*",
        "https://*.keypassguard.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "assets/ext-icon.png"
            ],
            "matches": ["<all_urls>"]
        }
    ],
    "action": {
        "default_icon": {
            "16": "assets/ext-icon.png",
            "24": "assets/ext-icon.png",
            "32": "assets/ext-icon.png"
        },
        "default_title": "Keypass Guard",
        "default_popup": "index.html"
    },
    "icons": {
        "16": "assets/ext-icon.png",
        "24": "assets/ext-icon.png",
        "32": "assets/ext-icon.png"
    }
}